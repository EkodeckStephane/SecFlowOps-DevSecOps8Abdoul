# Python and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node and package-manager caches
node_modules/
.npm-cache/
npm-cache/

# LaTeX build outputs
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Manuscript sources and local article drafts are kept out of the GitHub artifact repository
SecFlowOps/paper/
article/
bib_keys.txt
bibliography.bib
review_secflow_q1.md

# SecFlowOps generated runtime outputs
SecFlowOps/data/raw/
SecFlowOps/data/regression_workspaces/
SecFlowOps/data/normalized/*
!SecFlowOps/data/normalized/
!SecFlowOps/data/normalized/remediation_pr_probe.jsonl
SecFlowOps/artifact/trivy_cache/
SecFlowOps/artifact/semgrep_home/
SecFlowOps/artifact/semgrep_cache/
SecFlowOps/artifact/zap_home/
SecFlowOps/tmp_nodegoat_npm_probe/

# Bundled/downloaded local tools are reproducible from artifact documentation
SecFlowOps/tools/

# Generated or imported corpora are regenerated by scripts or too large for source control
SecFlowOps/repos/controlled_api_*/
SecFlowOps/repos/external_*/
SecFlowOps/repos/full_*/
SecFlowOps/repos/injected_*/
SecFlowOps/repos/**/.git/
SecFlowOps/repos/**/.github/
SecFlowOps/repos/**/.env*

